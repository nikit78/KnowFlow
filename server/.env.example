PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=
JWT_SECRET=

# Google Identity (ID token verification)
GOOGLE_CLIENT_ID=

# LLM provider: nvidia | openai
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Embedding provider: nvidia | openai
EMBEDDING_PROVIDER=nvidia
NVIDIA_EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# Optional OpenAI fallback
OPENAI_API_KEY=
